{
  "manifest_version": 3,
  "name": "Northgrain CRM",
  "description": "Capture LinkedIn relationships into Northgrain CRM with manual confirmation.",
  "version": "0.1.0",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://localhost:3001/*", "https://*/*"],
  "action": {
    "default_title": "Add to Northgrain",
    "default_popup": "popup.html"
  }
}
