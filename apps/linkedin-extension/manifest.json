{
	"manifest_version": 3,
	"name": "Northgrain CRM",
	"description": "Capture LinkedIn relationships into Northgrain CRM with manual confirmation.",
	"version": "0.2.0",
	"permissions": ["activeTab", "storage"],
	"host_permissions": ["http://localhost:3001/*", "https://*/*"],
	"background": {
		"service_worker": "background.js"
	},
	"content_scripts": [
		{
			"matches": ["https://*.linkedin.com/*"],
			"js": ["content.js"],
			"run_at": "document_idle"
		}
	],
	"action": {
		"default_title": "Northgrain settings",
		"default_popup": "popup.html"
	}
}
